# Windows on the same machine as Plex: 127.0.0.1
# Debian VM accessed from Windows: the VM's private LAN IP
BIND_ADDRESS=127.0.0.1
PORT=8765
MAX_HTTP_WORKERS=32

# Optional built-in HTTPS (use together with compose.https.yaml).
# TLS_CERT_FILE_HOST=/etc/letsencrypt/live/codex.example/fullchain.pem
# TLS_KEY_FILE_HOST=/etc/letsencrypt/live/codex.example/privkey.pem
